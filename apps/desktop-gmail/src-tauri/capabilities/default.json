{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Desktop Gmail",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://mail.google.com/*",
      "https://accounts.google.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "shell:default",
    "shell:allow-open",
    "notification:default"
  ]
}
