{
  "name": "desktop-google-apps-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Native-feeling Windows 11 desktop applications for Gmail and Google Calendar built with Tauri v2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test": "cargo test --package desktop-google-core && npm run test:ui",
    "test:ui": "node tests/about-dialog.test.js && node tests/icon-assets.test.js && node tests/observers.test.js",
    "check": "cargo check --target x86_64-pc-windows-msvc --workspace",
    "fmt": "cargo fmt --all --check",
    "build": "cargo build --target x86_64-pc-windows-msvc --workspace --release",
    "build:mail": "cargo build --target x86_64-pc-windows-msvc --package desktop-gmail --bin desktop-mail --release",
    "build:calendar": "cargo build --target x86_64-pc-windows-msvc --package desktop-gcalendar --bin desktop-calendar --release",
    "ci": "bash scripts/ci.sh",
    "build:installers": "node scripts/build-installers.js",
    "release:prepare": "node scripts/prepare-release.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "jsdom": "^29.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
